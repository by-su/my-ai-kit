# my-ai-kit Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# .env is automatically ignored by git to keep your secrets safe.

# GitHub Personal Access Token (for github MCP)
GITHUB_TOKEN=your_github_token_here

# Google OAuth Credentials (for google-docs MCP)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Brave Search API Key (for brave-search MCP)
BRAVE_API_KEY=your_brave_search_api_key_here

# MySQL Database Credentials (for mysql MCP)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=your_database_name_here
