def prompt_setup_selection(title, items, default_selected, single=False, allow_delete=False, categories=None, active_category=None):
    names = list(items.keys()) if isinstance(items, dict) else list(items)
    default_selected = set(default_selected)
    rows = []
    for name in names:
        desc = ""
        meta = {}
        if isinstance(items, dict):
            conf = items[name] or {}
            desc = conf.get("description", "")
            meta = {"active": conf.get("active", False)}
        rows.append((name, desc, meta))

    result = run_multiselect(title, rows, default_selected, single=single, allow_delete=allow_delete, categories=categories, active_category=active_category)
    if result is not None:
        return result

    print(f"\n\033[1;36m{title}\033[0m")
    if categories:
        tabs = []
        for cat in categories:
            if cat == active_category:
                tabs.append(f"\033[1;7m[{cat}]\033[0m")
            else:
                tabs.append(f"\033[90m{cat}\033[0m")
        print("  " + " \033[90m|\033[0m ".join(tabs))

    for idx, row in enumerate(rows, 1):
        name, desc, meta = row
        marker = "x" if name in default_selected else " "
        active = " \033[1;32m● active\033[0m" if meta.get("active") else ""
        print(f"  {idx:2d}. [{marker}] {name}{active}")
        for detail in str(desc).splitlines():
            print(f"       {detail}")

    if allow_delete:
        if single:
            print("Enter one number/name, 'd <num>' to delete, 'b' to go back, or 'q' to cancel. Press Enter to keep default.")
        else:
            print("Enter numbers/names separated by commas, 'd <num>' to delete, 'all', 'none', 'b' to go back, or 'q' to cancel. Press Enter to keep defaults.")
    else:
        if single:
            print("Enter one number/name, 'b' to go back, or 'q' to cancel. Press Enter to keep default.")
        else:
            print("Enter numbers/names separated by commas, 'all', 'none', 'b' to go back, or 'q' to cancel. Press Enter to keep defaults.")
    try:
        raw = input("> ")
    except EOFError:
        return set(default_selected), "cancel"
    selected, action, warnings = parse_setup_selection(raw, names, default_selected, allow_delete=allow_delete)
    if single and selected and action != "delete":
        selected = {next(name for name in names if name in selected)}
    for warning in warnings:
        print(f"\033[1;33mWarning:\033[0m {warning}")
    return selected, action

def get_setup_profile_keywords(manifest):
    keywords = list(SETUP_PROFILE_KEYWORDS)
    for profile in manifest.get("profiles", {}).values():
        for keyword in profile.get("include", []):
            if keyword != "*" and keyword not in keywords:
                keywords.append(keyword)
    return keywords

def normalize_custom_profile_name(raw):
    slug = re.sub(r"[^a-z0-9_-]+", "-", raw.strip().lower())
    slug = slug.strip("-_")
    return slug or "custom"

def prompt_custom_profile_name(default_name):
    print("\n\033[1;36mCustom profile name\033[0m")
    print(f"Enter a name for this profile. Press Enter to use '{default_name}'.")
    try:
        raw = input("> ")
    except EOFError:
        return normalize_custom_profile_name(default_name)
    return normalize_custom_profile_name(raw or default_name)

def print_profile_keywords(label, keywords):
    print(f"\n\033[1;36m{label}\033[0m")
    if not keywords:
        print("  (no languages/stacks selected)")
    elif "*" in keywords:
        print("  all stacks (*)")
    else:
        width = shutil.get_terminal_size((88, 20)).columns
        line = "  "
        for keyword in sorted(keywords):
            part = keyword if line == "  " else f", {keyword}"
            if str_display_width(line + part) > max(32, width - 2):
                print(line)
                line = f"  {keyword}"
            else:
                line += part
        print(line)

def print_selected_profile_details(profile_name, description, keywords):
    print(f"\n\033[1;36mSelected profile: {profile_name}\033[0m")
    print_wrapped_field("Description", description or "No description")
    print_wrapped_field("Stacks", format_stack_summary(keywords))

def print_wrapped_field(label, value):
    width = shutil.get_terminal_size((88, 20)).columns
    prefix = f"  {label}: "
    continuation = " " * str_display_width(prefix)
    line = prefix
    for word in str(value).split(" "):
        if not word:
            continue
        part = word if line == prefix else f" {word}"
        if str_display_width(line + part) > max(40, width - 2):
            print(line)
            line = continuation + word
        else:
            line += part
    print(line)

def format_stack_summary(keywords):
    if not keywords:
        return "no languages/stacks selected"
    if "*" in keywords:
        return "all stacks (*)"
    return ", ".join(sorted(keywords))

def format_profile_details(description, keywords):
    description = description or "No description"
    return f"Description: {description}\nStacks: {format_stack_summary(keywords)}"

def get_custom_profiles(state):
    custom_profiles = dict(state.get("custom_profiles", {}))
    active_profile = state.get("active_profile", "")
    if active_profile.startswith("custom:"):
        name = active_profile.split(":", 1)[1] or state.get("custom_profile_name", "custom")
        if name not in custom_profiles:
            custom_profiles[name] = {
                "description": f"custom profile '{name}'",
                "include": state.get("profile_keywords", []),
            }
    return custom_profiles

def save_custom_profile(state, name, keywords, description=None):
    custom_profiles = get_custom_profiles(state)
    custom_profiles[name] = {
        "description": description or f"custom profile '{name}'",
        "include": sorted(keywords),
    }
    state["custom_profiles"] = custom_profiles
    state["active_profile"] = f"custom:{name}"
    state["custom_profile_name"] = name
    state["profile_keywords"] = sorted(keywords)

def display_profile_name(profile_name):
    if profile_name.startswith("custom:"):
        return profile_name.split(":", 1)[1]
    return profile_name

def str_display_width(s):
    clean = re.sub(r'\033\[[0-9;]*m', '', str(s))
    w = 0
    for ch in clean:
        w += 2 if unicodedata.east_asian_width(ch) in ('F', 'W') else 1
    return w

def pad_cell(s, width):
    w = str_display_width(s)
    if w >= width:
        return s
    return s + ' ' * (width - w)

def cmd_list(args=None):
    manifest = load_manifest()
    state = load_state()
    local_state = load_local_state()
    active_profile = get_active_profile()

    target_query = args[0].lower() if args else None

    if target_query:
        if "mengto" in target_query:
            mengto_dir = Path("~/.agent-skills/store/mengto-pruned-skills").expanduser()
            if not mengto_dir.exists():
                mengto_dir = Path("~/.agent-skills/store/fetched/mengto-skills/agent-skills").expanduser()
            print(f"\033[1;36m🎨 [MengTo Skills Breakdown]\033[0m ({mengto_dir})\n")
            if mengto_dir.exists():
                items = sorted([x.name for x in mengto_dir.iterdir() if x.is_dir()])
                print(f"Active Profile '\033[1;32m{active_profile}\033[0m' loaded {len(items)} skills:\n")
                col_w = 32
                formatted_items = [f"• {s}" for s in items]
                for i in range(0, len(formatted_items), 3):
                    row = formatted_items[i:i+3]
                    print("  " + "  ".join(pad_cell(item, col_w) for item in row))
                print(f"\n\033[1;32mTotal: {len(items)} pruned MengTo skills.\033[0m")
            else:
                print("⚠️ mengto-skills repository not downloaded yet. Run 'mykit sync' first.")
            return

        if "ecc" in target_query:
            ecc_dir = Path("~/.agent-skills/store/ecc-pruned-skills").expanduser()
            print(f"\033[1;36m⚡ [Everything Claude Code (ECC) Pruned Suite]\033[0m ({ecc_dir})\n")
            if ecc_dir.exists():
                items = sorted([x.name for x in ecc_dir.iterdir() if x.is_dir()])
                print(f"Active Profile '\033[1;32m{active_profile}\033[0m' loaded {len(items)} skills:\n")
                col_w = 32
                formatted_items = [f"• {it}" for it in items]
                for i in range(0, len(formatted_items), 3):
                    row = formatted_items[i:i+3]
                    print("  " + "  ".join(pad_cell(item, col_w) for item in row))
                print(f"\n\033[1;32mTotal: {len(items)} pruned ECC skills.\033[0m")
            else:
                print("⚠️ ecc-suite not pruned yet. Run 'mykit sync' first.")
            return

    global_enabled = set(state.get("enabled_optionals", []))
    local_enabled = set(local_state.get("enabled_optionals", []))
    disabled_optionals = set(state.get("disabled_optionals", []))

    # --- Header Box ---
    total_inner_width = 86
    title_str = "🧰 MY-AI-KIT DASHBOARD"
    profile_str = f"Active Profile: {active_profile}"
    left_part = f"  {title_str}"
    right_part = f"{profile_str}  "
    space_needed = max(1, total_inner_width - str_display_width(left_part) - str_display_width(right_part))
    
    print("\033[1;36m┌" + "─" * total_inner_width + "┐\033[0m")
    print(f"\033[1;36m│\033[0m  \033[1;36m{title_str}\033[0m" + " " * space_needed + f"Active Profile: \033[1;32m{active_profile}\033[0m  \033[1;36m│\033[0m")
    print("\033[1;36m└" + "─" * total_inner_width + "┘\033[0m")

    # --- MCP Servers ---
    print("\n\033[1;34m⚡ MCP SERVERS\033[0m")
    active_mcps, disabled_mcps = get_mcp_states()
    mcps_all = manifest.get("global", {}).get("mcp_servers", {})
    mcp_items = []
    for name in mcps_all:
        if name in active_mcps:
            mcp_items.append(f"\033[1;32m🟢 {name}\033[0m")
        else:
            mcp_items.append(f"\033[90m⚪ {name} (off)\033[0m")

    col_w = 26
    for i in range(0, len(mcp_items), 3):
        row = mcp_items[i:i+3]
        formatted_row = "  ".join(pad_cell(item, col_w) for item in row)
        print(f"  {formatted_row}")

    # --- Custom Subagents ---
    print("\n\033[1;34m🤖 CUSTOM SUBAGENTS\033[0m")

    # Local agents/*.md
    agents_dir = KIT_DIR / "agents"
    found_agents = list(agents_dir.glob("*.md")) if agents_dir.exists() else []
    if found_agents:
        print(f"  \033[90m[my-ai-kit/agents]\033[0m")
        for f in found_agents:
            print(f"    • \033[1;32m{f.stem}\033[0m \033[90m({f.name})\033[0m")

    # Agents from active optional skill packs
    from src.symlink import find_pack_agents
    pack_agent_found = False
    for item in manifest.get("optional", []):
        name = item.get("name")
        is_default = item.get("default_enabled", False)
        is_loc = name in local_enabled
        is_glob = (name in global_enabled) or (is_default and name not in disabled_optionals)
        if not (is_loc or is_glob):
            continue
        path = resolve_skill_path(item)
        pack_agents = find_pack_agents(path, fetched_name=name) if path and path.exists() else []
        if pack_agents:
            pack_agent_found = True
            print(f"  \033[90m[{name}]\033[0m \033[90m({len(pack_agents)} agents)\033[0m")
            for f in sorted(pack_agents, key=lambda x: x.name)[:5]:
                print(f"    • \033[1;32m{f.stem}\033[0m")
            if len(pack_agents) > 5:
                print(f"    \033[90m... and {len(pack_agents) - 5} more\033[0m")

    if not found_agents and not pack_agent_found:
        print("  \033[90m(No custom agents configured)\033[0m")


    # --- Core Skills ---
    print("\n\033[1;34m📦 CORE SKILLS (Always Global)\033[0m")
    core_items = manifest.get("core", [])
    if core_items:
        for item in core_items:
            name = item.get("name")
            src = item.get("source", "local")
            path = resolve_skill_path(item)
            auto_up = " \033[90m[auto-update]\033[0m" if item.get("auto_update") else ""
            status = "\033[1;32m✓\033[0m" if path and path.exists() else "\033[1;31m✗\033[0m"
            print(f"  {status} \033[1m{name}\033[0m \033[90m({src})\033[0m{auto_up}")
    else:
        print("  \033[90m(No core skills configured)\033[0m")

    # --- Optional Skills Table ---
    print("\n\033[1;35m🧩 OPTIONAL SKILLS\033[0m")
    
    hdr_status = pad_cell("\033[1;37mSTATUS\033[0m", 12)
    hdr_name = pad_cell("\033[1;37mNAME\033[0m", 24)
    hdr_sub = pad_cell("\033[1;37mSUB-SKILLS\033[0m", 12)
    hdr_desc = "\033[1;37mDESCRIPTION\033[0m"

    print(f"  {hdr_status}  {hdr_name}  {hdr_sub}  {hdr_desc}")
    print("  " + "─" * 12 + "  " + "─" * 24 + "  " + "─" * 12 + "  " + "─" * 32)

    for item in manifest.get("optional", []):
        name = item.get("name")
        desc = item.get("description", "")
        src = item.get("source", "local")
        is_default = item.get("default_enabled", False)

        is_loc = name in local_enabled
        is_glob = (name in global_enabled) or (is_default and name not in disabled_optionals)

        if is_loc:
            status_str = "\033[1;32m📍 Local\033[0m"
        elif is_glob:
            status_str = "\033[1;36m🌐 Global\033[0m"
        else:
            status_str = "\033[90m⚪ Off\033[0m"

        path = resolve_skill_path(item)
        sub_count = len(find_sub_skills(path)) if path and path.exists() else 0
        sub_str = f"{sub_count} skills" if sub_count > 1 else "-"

        name_str = f"\033[1m{name}\033[0m"

        cell_stat = pad_cell(status_str, 12)
        cell_n = pad_cell(name_str, 24)
        cell_sb = pad_cell(sub_str, 12)

        print(f"  {cell_stat}  {cell_n}  {cell_sb}  {desc}")
    
    print("\n\033[90m💡 To view detailed breakdown of a skill pack, run: \033[1mmykit list mengto\033[0m or \033[1mmykit list ecc\033[0m")


def cmd_reset():
    print("\033[1;33m🧹 Performing Deep Reset of all agent configurations, legacy commands, cached stores, and symlinks...\033[0m\n")

    cwd = Path.cwd()
    home = Path.home()

    legacy_targets = [
        home / ".claude" / "skills",
        home / ".claude" / "agents",
        home / ".claude" / "commands",
        home / ".claude" / "plugins",
        home / ".gemini" / "antigravity-cli" / "skills",
        home / ".gemini" / "antigravity-cli" / "agents",
        home / ".gemini" / "skills",
        home / ".gemini" / "agents",
        home / ".codex" / "skills",
        home / ".codex" / "agents",
        home / ".codex" / "prompts",
    ]

    for d in legacy_targets:
        if d.exists():
            for item in d.glob("*"):
                if item.name in ("cache", "data", "installed_plugins.json"):
                    continue
                if item.is_symlink() or item.is_file():
                    item.unlink()
                elif item.is_dir():
                    shutil.rmtree(item)
            print(f"  ✓ Cleaned directory: {d}")

    for adapter in ALL_ADAPTERS:
        l_s_dir = adapter.get_target_dir(is_local=True, cwd=cwd)
        l_a_dir = adapter.get_agent_target_dir(is_local=True, cwd=cwd)
        for d in [l_s_dir, l_a_dir]:
            if d.exists():
                shutil.rmtree(d)
                print(f"  ✓ Wiped local pwd adapter: {d}")

    for target in MCP_TARGETS:
        if target.exists():
            target.unlink()
            print(f"  ✓ Reset MCP config: {target}")

    store_dir = home / ".agent-skills"
    if store_dir.exists():
        shutil.rmtree(store_dir)
        print(f"  ✓ Wiped cached skill store: {store_dir}")

    local_json = cwd / ".mykit.json"
    if local_json.exists():
        local_json.unlink()
        print(f"  ✓ Removed local state file: {local_json}")

    print("\n\033[1;32m🎉 Deep Reset complete! All legacy commands and skills wiped 100%. Run 'mykit sync' to re-apply a fresh configuration.\033[0m")

def cmd_mcp(args):
    manifest = load_manifest()
    mcps_all = manifest.get("global", {}).get("mcp_servers", {})
    active_mcps, disabled_mcps = get_mcp_states()

    if not args or args[0] in ("list", "status"):
        print("\033[1;34m--- Registered MCP Servers ---\033[0m\n")
        for name in mcps_all:
            status = "\033[1;32m[x] Enabled\033[0m" if name in active_mcps else "[ ] Disabled"
            print(f"  • \033[1m{name}\033[0m: {status}")
        print("\nTo toggle: \033[1mmykit mcp enable <name>\033[0m | \033[1mmykit mcp disable <name>\033[0m")
    elif args[0] in ("enable", "install"):
        if len(args) < 2:
            print("Usage: mykit mcp enable <mcp-name>")
            sys.exit(1)
        name = args[1]
        if name not in mcps_all:
            print(f"\033[1;31mError:\033[0m MCP server '{name}' not found in manifest.yaml")
            sys.exit(1)

        state = load_state()
        en = set(state.get("enabled_mcps", []))
        dis = set(state.get("disabled_mcps", []))
        en.add(name)
        dis.discard(name)
        state["enabled_mcps"] = list(en)
        state["disabled_mcps"] = list(dis)
        save_state(state)
        print(f"✓ Enabled MCP server '\033[1;32m{name}\033[0m'")
        cmd_sync()
    elif args[0] in ("disable", "remove"):
        if len(args) < 2:
            print("Usage: mykit mcp disable <mcp-name>")
            sys.exit(1)
        name = args[1]
        state = load_state()
        en = set(state.get("enabled_mcps", []))
        dis = set(state.get("disabled_mcps", []))
        en.discard(name)
        dis.add(name)
        state["enabled_mcps"] = list(en)
        state["disabled_mcps"] = list(dis)
        save_state(state)
        print(f"✓ Disabled MCP server '\033[1;33m{name}\033[0m'")
        cmd_sync()

def cmd_setup():
    manifest = load_manifest()
    mcps_all = manifest.get("global", {}).get("mcp_servers", {})
    optionals = manifest.get("optional", [])
    optionals_by_name = {item.get("name"): item for item in optionals}

    state = load_state()
    custom_profiles = get_custom_profiles(state)
    profile_items = {"add": {"description": "새 profile 생성"}}
    for name, info in custom_profiles.items():
        profile_items[name] = {"description": format_profile_details(info.get("description", ""), info.get("include", []))}
    category_items = {
        cat: {"description": ", ".join(kws[:5]) + "..."}
        for cat, kws in SETUP_KEYWORD_CATEGORIES.items()
    }
    profile_keywords = get_setup_profile_keywords(manifest)
    has_existing_profile = (STATE_FILE.exists() or bool(state)) and bool(state.get("active_profile") or get_active_profile())
    current_profile = state.get("active_profile", get_active_profile()) if has_existing_profile else "add"
    selected_profile = current_profile
    custom_profile_name = state.get("custom_profile_name", "default")
    if current_profile.startswith("custom:"):
        custom_profile_name = current_profile.split(":", 1)[1] or custom_profile_name
        selected_profile = custom_profile_name
    elif current_profile not in profile_items:
        selected_profile = "add"
    if selected_profile in custom_profiles:
        default_profile_keywords = set(custom_profiles[selected_profile].get("include", []))
    else:
        default_profile_keywords = set(state.get("profile_keywords", []))

    current_enabled_mcps = set(state.get("enabled_mcps", []))
    current_disabled_mcps = set(state.get("disabled_mcps", []))
    default_mcps = {
        name for name, conf in mcps_all.items()
        if name in current_enabled_mcps or (conf.get("enabled", True) and name not in current_disabled_mcps)
    }

    current_enabled_skills = set(state.get("enabled_optionals", []))
    current_disabled_skills = set(state.get("disabled_optionals", []))
    default_skills = {
        item.get("name") for item in optionals
        if item.get("name") in current_enabled_skills
        or (item.get("default_enabled", False) and item.get("name") not in current_disabled_skills)
    }
    selections = {
        "profile_keywords": set(default_profile_keywords),
        "mcps": set(default_mcps),
        "skills": set(default_skills),
        "pruning_packs": set(get_enabled_pruning_packs(state)),
    }

    base_steps = ["profile"] if custom_profiles else []
    kw_steps = [f"kw_cat:{cat}" for cat in SETUP_KEYWORD_CATEGORIES]
    rest_steps = ["skills", "pruning_packs", "mcps"]
    step_keys = base_steps + kw_steps + rest_steps

    print("\033[1;36m--- mykit initial setup ---\033[0m")
    if not custom_profiles:
        print("No stack profile found. Create one to use as your default profile.")
        custom_profile_name = prompt_custom_profile_name(custom_profile_name)
    idx = 0
    while idx < len(step_keys):
        key = step_keys[idx]
        if key == "profile":
            title = "Profile"
            items = profile_items
        elif key.startswith("kw_cat:"):
            cat_name = key.split(":", 1)[1]
            title = f"Languages and stacks ({cat_name})"
            items = SETUP_KEYWORD_CATEGORIES.get(cat_name, [])
        elif key == "profile_keywords":
            title = "Languages and stacks for pruning"
            items = profile_keywords
        elif key == "skills":
            title = "Global optional skills to enable"
            items = optionals_by_name
        elif key == "pruning_packs":
            selected_prunable_skills = selections["skills"].intersection(PRUNABLE_PACKS)
            if not selected_prunable_skills:
                selections["pruning_packs"] = set()
                idx += 1
                continue
            title = "Enabled skill packs to prune by selected stack"
            items = {
                name: optionals_by_name[name]
                for name in optionals_by_name
                if name in selected_prunable_skills
            }
            selections["pruning_packs"].intersection_update(selected_prunable_skills)
        else:
            title = "MCP servers to enable"
            items = mcps_all

        allow_del = (key == "profile" and bool(custom_profiles))
        if key == "profile":
            default_selected = {selected_profile}
        elif key.startswith("kw_cat:"):
            cat_name = key.split(":", 1)[1]
            cat_kws = SETUP_KEYWORD_CATEGORIES.get(cat_name, [])
            default_selected = selections["profile_keywords"].intersection(cat_kws)
        else:
            default_selected = selections[key]

        categories_list = list(SETUP_KEYWORD_CATEGORIES.keys()) if key.startswith("kw_cat:") else None
        active_cat = key.split(":", 1)[1] if key.startswith("kw_cat:") else None
        selected, action = prompt_setup_selection(title, items, default_selected, single=(key == "profile"), allow_delete=allow_del, categories=categories_list, active_category=active_cat)
        if action == "cancel":
            print("\nSetup cancelled. No changes saved.")
            return
        if key == "profile":
            selected_profile = next(iter(selected), selected_profile)
            if action == "delete":
                if selected_profile == "add":
                    print("\n\033[1;33mCannot delete 'add' option.\033[0m")
                elif selected_profile in custom_profiles:
                    print(f"\n\033[1;33m⚠️  Are you sure you want to delete profile '\033[1;36m{selected_profile}\033[0m'? [y/N]\033[0m")
                    try:
                        answer = input("> ").strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        answer = "n"
                    if answer in ("y", "yes"):
                        del custom_profiles[selected_profile]
                        state["custom_profiles"] = custom_profiles
                        if state.get("active_profile") == f"custom:{selected_profile}" or state.get("custom_profile_name") == selected_profile:
                            state.pop("active_profile", None)
                            state.pop("custom_profile_name", None)
                        save_state(state)
                        print(f"✓ Deleted profile '\033[1;32m{selected_profile}\033[0m'")
                    else:
                        print("Deletion cancelled.")
                profile_items = {"add": {"description": "새 profile 생성"}}
                for name, info in custom_profiles.items():
                    profile_items[name] = {"description": format_profile_details(info.get("description", ""), info.get("include", []))}
                selected_profile = "add"
                continue
            elif selected_profile == "add":
                custom_profile_name = prompt_custom_profile_name(custom_profile_name)
                selections["profile_keywords"] = set()
            elif selected_profile in custom_profiles:
                custom_profile_name = selected_profile
                selections["profile_keywords"] = set(custom_profiles[selected_profile].get("include", []))
        elif key.startswith("kw_cat:"):
            cat_name = key.split(":", 1)[1]
            cat_kws = set(SETUP_KEYWORD_CATEGORIES.get(cat_name, []))
            selections["profile_keywords"] = (selections["profile_keywords"] - cat_kws) | set(selected)
        elif key == "profile_keywords":
            selections["profile_keywords"] = selected
        else:
            selections[key] = selected
        if action == "back":
            idx = max(0, idx - 1)
        else:
            idx += 1

    if selected_profile == "add" or selected_profile in custom_profiles:
        save_custom_profile(state, custom_profile_name, selections["profile_keywords"])
    state["enabled_pruning_packs"] = sorted(selections["pruning_packs"])
    state["enabled_mcps"] = sorted(selections["mcps"])
    state["disabled_mcps"] = sorted(set(mcps_all.keys()) - selections["mcps"])
    state["enabled_optionals"] = sorted(selections["skills"])
    state["disabled_optionals"] = sorted(set(optionals_by_name.keys()) - selections["skills"])
    save_state(state)

    print("\n✓ Saved initial setup preferences.")
    cmd_sync()

def cmd_profile(args):
    manifest = load_manifest()
    profiles = manifest.get("profiles", {})
    state = load_state()
    custom_profiles = get_custom_profiles(state)
    active_profile = get_active_profile()

    if not args or args[0] in ("list", "status"):
        print(f"\033[1;36m--- Active Profile: {display_profile_name(active_profile)} ---\033[0m\n")
        print("Profiles:")
        if custom_profiles:
            for name, info in custom_profiles.items():
                profile_id = f"custom:{name}"
                current = " \033[1;32m(active)\033[0m" if profile_id == active_profile else ""
                desc = info.get("description", "")
                print(f"  • \033[1;34m{name}\033[0m{current}: {desc}")
                print_wrapped_field("Stacks", format_stack_summary(info.get("include", [])))
        else:
            print("  (none - run \033[1mmykit profile edit\033[0m or \033[1mmykit setup\033[0m to create one)")
        print("\nTo switch profile: \033[1mmykit profile use <profile-name>\033[0m")
        print("To edit profile: \033[1mmykit profile edit\033[0m")
        print("To delete profile: \033[1mmykit profile remove <profile-name>\033[0m")
    elif args[0] in ("use", "set"):
        if len(args) < 2:
            print("Usage: mykit profile use <profile_name>")
            sys.exit(1)
        target_profile = args[1]
        if target_profile in custom_profiles:
            save_custom_profile(
                state,
                target_profile,
                custom_profiles[target_profile].get("include", []),
                custom_profiles[target_profile].get("description", ""),
            )
            save_state(state)
            target_profile = f"custom:{target_profile}"
        elif target_profile in profiles:
            save_custom_profile(
                state,
                target_profile,
                profiles[target_profile].get("include", []),
                profiles[target_profile].get("description", ""),
            )
            save_state(state)
            target_profile = f"custom:{target_profile}"
        else:
            print(f"\033[1;31mError:\033[0m Profile '{target_profile}' not found")
            available = list(custom_profiles.keys())
            if profiles:
                available += [f"{name} (template)" for name in profiles.keys()]
            print(f"Available profiles: {', '.join(available)}")
            sys.exit(1)

        print(f"✅ Switched active profile to '\033[1;32m{display_profile_name(target_profile)}\033[0m'")
        cmd_sync()
    elif args[0] in ("edit", "customize", "add", "create", "new"):
        cmd_setup()
    elif args[0] in ("remove", "delete", "rm"):
        if len(args) < 2:
            print("Usage: mykit profile remove <profile_name> [-y]")
            sys.exit(1)

        force = False
        target = None
        for arg in args[1:]:
            if arg in ("-y", "--yes", "--force"):
                force = True
            elif not target:
                target = arg

        if not target:
            print("Usage: mykit profile remove <profile_name> [-y]")
            sys.exit(1)

        if target not in custom_profiles:
            print(f"\033[1;31mError:\033[0m Profile '{target}' not found")
            print(f"Available profiles: {', '.join(custom_profiles.keys()) if custom_profiles else '(none)'}")
            sys.exit(1)

        if not force:
            print(f"\n\033[1;33m⚠️  Are you sure you want to delete profile '\033[1;36m{target}\033[0m'? [y/N]\033[0m")
            try:
                answer = input("> ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                print("\nDeletion cancelled.")
                return
            if answer not in ("y", "yes"):
                print("Deletion cancelled.")
                return

        del custom_profiles[target]
        state["custom_profiles"] = custom_profiles

        is_active = (active_profile == f"custom:{target}" or state.get("custom_profile_name") == target)
        if is_active:
            state.pop("active_profile", None)
            state.pop("custom_profile_name", None)
            if custom_profiles:
                next_profile = next(iter(custom_profiles))
                save_custom_profile(
                    state,
                    next_profile,
                    custom_profiles[next_profile].get("include", []),
                    custom_profiles[next_profile].get("description", ""),
                )
                save_state(state)
                print(f"✓ Deleted profile '\033[1;32m{target}\033[0m' and switched active profile to '\033[1;32m{next_profile}\033[0m'")
            elif profiles:
                next_profile = next(iter(profiles))
                save_custom_profile(
                    state,
                    next_profile,
                    profiles[next_profile].get("include", []),
                    profiles[next_profile].get("description", ""),
                )
                save_state(state)
                print(f"✓ Deleted profile '\033[1;32m{target}\033[0m' and switched active profile to template '\033[1;32m{next_profile}\033[0m'")
            else:
                save_state(state)
                print(f"✓ Deleted profile '\033[1;32m{target}\033[0m'")
        else:
            save_state(state)
            print(f"✓ Deleted profile '\033[1;32m{target}\033[0m'")

        cmd_sync()

cmd_stack = cmd_profile

def cmd_enable(skill_name, is_global=False):
    manifest = load_manifest()
    all_optionals = [item.get("name") for item in manifest.get("optional", [])]
    
    if skill_name not in all_optionals:
        print(f"\033[1;31mError:\033[0m Optional skill '{skill_name}' not found in manifest.yaml")
        sys.exit(1)

    cwd = Path.cwd()

    if is_global:
        state = load_state()
        enabled = set(state.get("enabled_optionals", []))
        disabled = set(state.get("disabled_optionals", []))
        enabled.add(skill_name)
        disabled.discard(skill_name)
        state["enabled_optionals"] = list(enabled)
        state["disabled_optionals"] = list(disabled)
        save_state(state)
        print(f"✓ Enabled optional skill '{skill_name}' [Global Scope]")
    else:
        local_state = load_local_state(cwd)
        enabled = set(local_state.get("enabled_optionals", []))
        enabled.add(skill_name)
        local_state["enabled_optionals"] = list(enabled)
        save_local_state(local_state, cwd)
        print(f"✓ Enabled optional skill '{skill_name}' [Local Scope: {cwd}]")

    cmd_sync()

    # Trigger post-install automatic dedupe hook if enabled
    auto_dedupe = manifest.get("auto_dedupe_on_install", True)
    if auto_dedupe:
        print("\n\033[1;36m🔄 Post-Install Hook: Running automatic dedupe check for newly installed skill...\033[0m\n")
        run_dedupe(threshold=30.0, focus_skill=skill_name)

def cmd_disable(skill_name, is_global=False):
    cwd = Path.cwd()

    if is_global:
        state = load_state()
        enabled = set(state.get("enabled_optionals", []))
        disabled = set(state.get("disabled_optionals", []))
        enabled.discard(skill_name)
        disabled.add(skill_name)
        state["enabled_optionals"] = list(enabled)
        state["disabled_optionals"] = list(disabled)
        save_state(state)

        for adapter in ALL_ADAPTERS:
            adapter.unlink_skill(skill_name, is_local=False)
        print(f"✓ Disabled optional skill '{skill_name}' [Global Scope]")
    else:
        local_state = load_local_state(cwd)
        enabled = set(local_state.get("enabled_optionals", []))
        enabled.discard(skill_name)
        local_state["enabled_optionals"] = list(enabled)
        save_local_state(local_state, cwd)

        for adapter in ALL_ADAPTERS:
            adapter.unlink_skill(skill_name, is_local=True, cwd=cwd)
        print(f"✓ Disabled optional skill '{skill_name}' [Local Scope: {cwd}]")

def cmd_sync(include_all=False):
    manifest = load_manifest()
    lockfile = load_lockfile()
    active_profile = get_active_profile()
    enabled_pruning_packs = get_enabled_pruning_packs()

    # 1. Fetch only active GitHub skills by default. Use --all for explicit prefetch.
    active_skills = get_active_skill_items(manifest, cwd=Path.cwd(), include_all=include_all)
    for item in active_skills:
        if item.get("source") == "github":
            name = item.get("name")
            url = item.get("url")
            auto_update = item.get("auto_update", False)
            commit_sha = lockfile.get("skills", {}).get(name, {}).get("commit")
            fetch_skill_repo(name, url, commit_sha, auto_update=auto_update)

    # 2. Prune ECC suite according to active profile
    ecc_fetched = Path("~/.agent-skills/store/fetched/ecc-suite").expanduser()
    ecc_cache = Path("~/.claude/plugins/cache/ecc/ecc/2.0.0").expanduser()
    ecc_base = ecc_fetched if ecc_fetched.exists() else ecc_cache
    ecc_target = Path("~/.agent-skills/store/ecc-pruned-skills").expanduser()
    if "ecc-suite" in enabled_pruning_packs and ecc_base.exists():
        inc, exc = prune_skills_for_profile(ecc_base, ecc_target, active_profile)
        print(f"⚡ Stack Profile '\033[1;36m{active_profile}\033[0m': Pruned {len(inc)} ECC skills ({len(exc)} excluded) into {ecc_target}")

    # 2.5 Prune ECC agents according to active profile
    ecc_agents_src = ecc_base / "agents" if ecc_base.exists() else None
    ecc_agents_target = Path("~/.agent-skills/store/ecc-suite-pruned-agents").expanduser()
    if "ecc-suite" in enabled_pruning_packs and ecc_agents_src and ecc_agents_src.exists():
        inc_a, exc_a = prune_pack_agents_for_profile(ecc_agents_src, ecc_agents_target, active_profile)
        print(f"🤖 Stack Profile '\033[1;36m{active_profile}\033[0m': Pruned {len(inc_a)} ECC agents ({len(exc_a)} excluded) into {ecc_agents_target}")

    # 3. Prune MengTo skills according to active profile
    mengto_fetched = Path("~/.agent-skills/store/fetched/mengto-skills").expanduser()
    mengto_target = Path("~/.agent-skills/store/mengto-pruned-skills").expanduser()
    if "mengto-skills" in enabled_pruning_packs and mengto_fetched.exists():
        inc, exc = prune_mengto_skills_for_profile(mengto_fetched, mengto_target, active_profile)
        print(f"🎨 Stack Profile '\033[1;36m{active_profile}\033[0m': Pruned {len(inc)} MengTo skills ({len(exc)} excluded) into {mengto_target}")

    # 4. Sync MCPs
    mcp_results = sync_mcp_servers()

    # 5. Sync Permissions (Auto-approve commands)
    perm_results = sync_auto_approve_permissions()

    # 6. Sync symlinks (both global & pwd local skills + custom agents)
    results = sync_active_skills(cwd=Path.cwd())
    print("\033[1;32m✓ Synchronized skills, custom agents, permissions, and MCPs across all adapters:\033[0m")
    for r in mcp_results:
        print(f"  - {r}")
    for r in perm_results:
        print(f"  - {r}")
    for r in results:
        print(f"  - {r}")

def cmd_update(target_skill=None, include_all=False):
    manifest = load_manifest()
    lockfile = load_lockfile()
    all_skills = manifest.get("core", []) + manifest.get("optional", [])
    github_skills = {item.get("name"): item for item in all_skills if item.get("source") == "github"}

    if target_skill:
        if target_skill not in github_skills:
            print(f"\033[1;31mError:\033[0m GitHub skill '{target_skill}' not found in manifest.yaml")
            sys.exit(1)
        item = github_skills[target_skill]
        update_skill_repo(item.get("name"), item.get("url"))
    else:
        if include_all:
            update_items = github_skills
            print("🔄 Updating all GitHub skills to latest remote commits...")
        else:
            locked = set(lockfile.get("skills", {}).keys())
            fetched_dir = CACHE_DIR / "fetched"
            fetched = {p.name for p in fetched_dir.iterdir()} if fetched_dir.exists() else set()
            update_items = {name: item for name, item in github_skills.items() if name in locked or name in fetched}
            print("🔄 Updating fetched GitHub skills to latest remote commits...")
            if not update_items:
                print("No fetched GitHub skills found. Use 'mykit prefetch <skill-name>' or 'mykit update --all'.")
                return
        for name, item in update_items.items():
            update_skill_repo(name, item.get("url"))
            
    cmd_sync()

def cmd_prefetch(args):
    manifest = load_manifest()
    lockfile = load_lockfile()
    all_skills = manifest.get("core", []) + manifest.get("optional", [])
    github_skills = {item.get("name"): item for item in all_skills if item.get("source") == "github"}

    if not args:
        print("Usage: mykit prefetch <skill-name|--all>")
        sys.exit(1)

    if "--all" in args:
        items = github_skills.values()
    else:
        missing = [name for name in args if name not in github_skills]
        if missing:
            print(f"\033[1;31mError:\033[0m GitHub skill(s) not found in manifest.yaml: {', '.join(missing)}")
            sys.exit(1)
        items = [github_skills[name] for name in args]

    for item in items:
        name = item.get("name")
        commit_sha = lockfile.get("skills", {}).get(name, {}).get("commit")
        fetch_skill_repo(name, item.get("url"), commit_sha, auto_update=item.get("auto_update", False))

def cmd_doctor():
    print("\033[1;36m--- Running mykit doctor ---\033[0m")
    manifest = load_manifest()
    mcps = manifest.get("global", {}).get("mcp_servers", {})
    auto_cmds = manifest.get("auto_approve_commands", [])
    active_profile = get_active_profile()
    print(f"✓ Active profile: {active_profile}")
    print(f"✓ Manifest loaded cleanly ({len(mcps)} MCPs, {len(auto_cmds)} auto-approve commands, {len(manifest.get('core', []))} core, {len(manifest.get('optional', []))} optional)")
    
    lockfile = load_lockfile()
    print(f"✓ Lockfile loaded ({len(lockfile.get('skills', {}))} locked repos)")

    print("\n\033[1;34m[MCP Server Health & Secret Key Check]\033[0m")
    reports = check_mcp_health()
    for name, cmd, status, missing in reports:
        print(f"  • {name} (cmd: {cmd}) -> {status}")

    print("\n\033[1;34m[Auto-Approved Command Allowlist]\033[0m")
    print(f"  🛡️ {len(auto_cmds)} pre-approved safe commands: {', '.join(auto_cmds[:10])}...")

    print("\n\033[1;34m[AI Agent Target Adapters]\033[0m")
    for adapter in ALL_ADAPTERS:
        g_dir = adapter.ensure_target_dir(is_local=False)
        ag_dir = adapter.ensure_agent_target_dir(is_local=False)
        skills_cnt = len(list(g_dir.glob("*")))
        agents_cnt = len(list(ag_dir.glob("*")))
        print(f"✓ Adapter [{adapter.name}] -> Skills: {skills_cnt} item(s) ({g_dir}) | Custom Agents: {agents_cnt} item(s) ({ag_dir})")

def main():
    if len(sys.argv) < 2:
        print("Usage: mykit [list|setup|stats|env|mcp|profile|install|remove|sync|prefetch|reset|update|lint|dedupe|doctor|completion|bootstrap]")
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == "list":
        cmd_list(sys.argv[2:])
    elif cmd == "setup":
        cmd_setup()
    elif cmd == "reset":
        cmd_reset()
    elif cmd == "stats":
        show_stats()
    elif cmd in ("env", "secret", "secrets"):
        sub = sys.argv[2] if len(sys.argv) >= 3 else "setup"
        if sub in ("setup", "init", "set"):
            setup_env_interactive()
            cmd_sync()
        else:
            print("Usage: mykit env setup")
    elif cmd == "mcp":
        cmd_mcp(sys.argv[2:])
    elif cmd in ("profile", "stack"):
        cmd_profile(sys.argv[2:])
    elif cmd == "completion":
        sub = sys.argv[2] if len(sys.argv) >= 3 else "install"
        generate_completion(sub)
    elif cmd in ("install", "enable"):
        if len(sys.argv) < 3:
            print("Usage: mykit install <skill-name> [--global]")
            sys.exit(1)
        is_global = "--global" in sys.argv
        skill_name = sys.argv[2] if sys.argv[2] != "--global" else sys.argv[3]
        cmd_enable(skill_name, is_global=is_global)
    elif cmd in ("remove", "disable"):
        if len(sys.argv) < 3:
            print("Usage: mykit remove <skill-name> [--global]")
            sys.exit(1)
        is_global = "--global" in sys.argv
        skill_name = sys.argv[2] if sys.argv[2] != "--global" else sys.argv[3]
        cmd_disable(skill_name, is_global=is_global)
    elif cmd in ("sync", "bootstrap"):
        cmd_sync(include_all="--all" in sys.argv[2:])
    elif cmd == "prefetch":
        cmd_prefetch(sys.argv[2:])
    elif cmd == "update":
        args = sys.argv[2:]
        include_all = "--all" in args
        if include_all:
            args.remove("--all")
        target = args[0] if args else None
        cmd_update(target, include_all=include_all)
    elif cmd == "lint":
        fix_option = "--fix" in sys.argv
        run_linter(fix=fix_option)
    elif cmd == "dedupe":
        args = sys.argv[2:]
        focus_skill = None
        include_all = False
        if "--all" in args:
            include_all = True
            args.remove("--all")
        if "--skill" in args:
            idx = args.index("--skill")
            if idx + 1 >= len(args):
                print("Usage: mykit dedupe [threshold] [--skill <skill-name>] [--all]")
                sys.exit(1)
            focus_skill = args[idx + 1]
            del args[idx:idx + 2]
        threshold = float(args[0]) if args and args[0].replace('.', '', 1).isdigit() else 30.0
        run_dedupe(threshold=threshold, focus_skill=focus_skill, include_all=include_all)
    elif cmd == "doctor":
        cmd_doctor()
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
